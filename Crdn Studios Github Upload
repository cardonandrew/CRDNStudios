  { genre: "alt-pop", title: "Can't Sleep", artist: "CRDN Studios, Deebomani", src: "data:application/octet-stream;base64,", duration: "0:38" },
  /* "Torture" — CRDN Studios, Deebomani. Clip is the 1:41–end segment of the full track (28 sec). Fades baked into file (0.5s in, 2s out), loudness-normalized to -14 LUFS. */
  { genre: "alt-pop", title: "Torture", artist: "CRDN Studios, Deebomani", src: "data:application/octet-stream;base64,", duration: "0:28" }

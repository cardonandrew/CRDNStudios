<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="data:," />
<title>CRDN Studios — Production, Mixing & Mastering</title>
<meta name="description" content="CRDN Studios — remote production, mixing, and mastering for pop and Christian artists. Services, pricing, and demos." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
:root{
  --sky-950:#05263C;
  --sky-900:#083654;
  --sky-800:#075985;
  --sky-700:#0369A1;
  --sky-600:#0284C7;
  --sky-500:#0EA5E9;
  --sky:#38BDF8;
  --sky-bright:#7DD3FC;
  --sky-pale:#E0F2FE;
  --pink:#F472B6;
  --pink-bright:#F9A8D4;
  --pink-deep:#EC4899;
  --pink-pale:#FCE7F3;
  --accent-sky:#0284C7;
  --accent-pink:#DB2777;
  --ink:#0B2536;
  --ink-soft:#2E4A5C;
  --muted:#577487;
  --bg:#F4FAFE;
  --surface:#FFFFFF;
  --card-border:rgba(3,105,161,.14);
  --glass:rgba(255,255,255,.78);
  --glass-border:rgba(255,255,255,.85);
  --shadow:0 20px 50px rgba(2,132,199,.13);
  --radius-lg:28px;
  --radius-md:20px;
  --hero-bg:linear-gradient(180deg,#DFF2FD 0%,#EAF6FE 48%,#FDEFF6 100%);
  --hero-photo-opacity:.6;
  --hero-wash:linear-gradient(180deg, rgba(255,255,255,.58) 0%, rgba(230,245,254,.44) 45%, rgba(252,231,243,.52) 100%);
  --aurora-bg:
    radial-gradient(52% 46% at 14% 4%, rgba(56,189,248,.60), transparent 65%),
    radial-gradient(48% 42% at 86% 10%, rgba(244,114,182,.55), transparent 65%),
    radial-gradient(40% 36% at 62% 44%, rgba(125,211,252,.35), transparent 70%),
    radial-gradient(62% 54% at 50% 92%, rgba(249,168,212,.38), transparent 70%),
    linear-gradient(180deg, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 45%, rgba(255,255,255,.30) 100%);
  --grain:repeating-linear-gradient(90deg, rgba(3,105,161,.045) 0 1px, transparent 1px 7px);
  --eyebrow-bg:rgba(255,255,255,.62);
  --eyebrow-ink:#075985;
  --eyebrow-border:rgba(2,132,199,.28);
  --ghost-bg:rgba(255,255,255,.55);
  --ghost-ink:#075985;
  --ghost-border:rgba(2,132,199,.35);
  --ghost-bg-hover:rgba(255,255,255,.85);
  --strip-bg:rgba(255,255,255,.52);
  --strip-line:rgba(2,132,199,.13);
  --pill-bg:var(--sky-pale);
  --pill-ink:#075985;
  --demos-bg:linear-gradient(180deg,#E7F5FE 0%,#FDF0F7 100%);
  --demos-glow:
    radial-gradient(46% 36% at 12% 0%, rgba(56,189,248,.34), transparent 65%),
    radial-gradient(42% 34% at 90% 8%, rgba(244,114,182,.30), transparent 65%),
    radial-gradient(55% 45% at 50% 110%, rgba(125,211,252,.35), transparent 70%);
  --tab-bg:rgba(255,255,255,.72);
  --tab-ink:var(--ink-soft);
  --tab-border:rgba(2,132,199,.20);
  --tab-bg-hover:#FFFFFF;
  --player-bg:rgba(255,255,255,.85);
  --track-line:rgba(2,132,199,.10);
  --track-hover:rgba(224,242,254,.55);
  --track-playing:rgba(252,231,243,.70);
  --prog-bg:rgba(2,132,199,.16);
  --play-off-bg:rgba(11,37,54,.08);
  --play-off-ink:rgba(11,37,54,.35);
  --badge-bg:rgba(255,255,255,.80);
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#051A29;
    --surface:#0A2A40;
    --ink:#F0F7FB;
    --ink-soft:#C9DEEA;
    --muted:#93B0C2;
    --accent-sky:#38BDF8;
    --accent-pink:#F9A8D4;
    --card-border:rgba(125,211,252,.16);
    --glass:rgba(10,42,64,.72);
    --glass-border:rgba(125,211,252,.20);
    --shadow:0 20px 50px rgba(0,0,0,.5);
    --hero-bg:#052136;
    --hero-photo-opacity:.5;
    --hero-wash:linear-gradient(180deg, rgba(5,33,54,.58) 0%, rgba(5,33,54,.46) 45%, rgba(5,33,54,.62) 100%);
    --aurora-bg:
      radial-gradient(52% 44% at 14% 4%, rgba(56,189,248,.38), transparent 65%),
      radial-gradient(46% 40% at 86% 10%, rgba(244,114,182,.34), transparent 65%),
      radial-gradient(38% 34% at 62% 42%, rgba(56,189,248,.16), transparent 70%),
      radial-gradient(60% 52% at 50% 95%, rgba(236,72,153,.20), transparent 70%),
      linear-gradient(180deg, rgba(5,33,54,.30) 0%, rgba(5,33,54,0) 45%, rgba(5,33,54,.55) 100%);
    --grain:repeating-linear-gradient(90deg, rgba(255,255,255,.03) 0 1px, transparent 1px 7px);
    --eyebrow-bg:rgba(255,255,255,.08);
    --eyebrow-ink:#BAE6FD;
    --eyebrow-border:rgba(125,211,252,.32);
    --ghost-bg:rgba(255,255,255,.10);
    --ghost-ink:#FFFFFF;
    --ghost-border:rgba(255,255,255,.35);
    --ghost-bg-hover:rgba(255,255,255,.18);
    --strip-bg:rgba(255,255,255,.05);
    --strip-line:rgba(255,255,255,.12);
    --pill-bg:rgba(56,189,248,.16);
    --pill-ink:#BAE6FD;
    --demos-bg:linear-gradient(180deg,#07293F 0%,#081E30 100%);
    --demos-glow:
      radial-gradient(46% 36% at 12% 0%, rgba(56,189,248,.30), transparent 65%),
      radial-gradient(42% 34% at 90% 8%, rgba(244,114,182,.24), transparent 65%),
      radial-gradient(55% 45% at 50% 110%, rgba(2,132,199,.35), transparent 70%);
    --tab-bg:rgba(255,255,255,.07);
    --tab-ink:#C9DEEA;
    --tab-border:rgba(255,255,255,.16);
    --tab-bg-hover:rgba(255,255,255,.13);
    --player-bg:rgba(255,255,255,.06);
    --track-line:rgba(255,255,255,.08);
    --track-hover:rgba(255,255,255,.05);
    --track-playing:rgba(244,114,182,.13);
    --prog-bg:rgba(255,255,255,.15);
    --play-off-bg:rgba(255,255,255,.12);
    --play-off-ink:rgba(255,255,255,.40);
    --badge-bg:rgba(244,114,182,.12);
  }
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms !important;transition-duration:.01ms !important}
}
body{
  margin:0;
  font-family:"Manrope",system-ui,-apple-system,sans-serif;
  background:var(--bg);
  color:var(--ink);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
h1,h2,h3,.display{font-family:"Outfit",sans-serif;line-height:1.02;letter-spacing:-.02em;margin:0}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:min(1120px,100% - 40px);margin-inline:auto}
@media (max-width:560px){.wrap{width:calc(100% - 32px)}}

/* ---------- NAV ---------- */
.nav-shell{position:sticky;top:14px;z-index:60;padding:0 16px}
.nav{
  width:min(1120px,100%);margin-inline:auto;
  display:flex;align-items:center;gap:10px;
  background:var(--glass);
  -webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);
  border:1px solid var(--glass-border);
  border-radius:999px;
  padding:8px 8px 8px 10px;
  box-shadow:0 10px 34px rgba(2,132,199,.16);
}
.nav-brand{display:flex;align-items:center;gap:10px;text-decoration:none;flex-shrink:0}
.nav-brand img{width:38px;height:38px;border-radius:12px;object-fit:cover;background:#fff}
.nav-brand span{font-family:"Outfit",sans-serif;font-weight:800;letter-spacing:.02em;font-size:15px;white-space:nowrap}
.nav-links{display:flex;gap:2px;margin-inline:auto;flex-wrap:wrap;justify-content:center}
.nav-links a{
  text-decoration:none;font-size:13.5px;font-weight:700;color:var(--ink-soft);
  padding:8px 13px;border-radius:999px;transition:background .2s,color .2s;
}
.nav-links a:hover{background:rgba(14,165,233,.13);color:var(--ink)}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  font-family:"Outfit",sans-serif;font-weight:700;font-size:15px;
  text-decoration:none;border:none;cursor:pointer;
  border-radius:999px;padding:13px 24px;
  transition:transform .18s,box-shadow .18s,background .18s;
}
.btn:active{transform:scale(.98)}
.btn-teal{background:linear-gradient(135deg,var(--sky-500),var(--sky-600));color:#fff;box-shadow:0 10px 26px rgba(14,165,233,.35)}
.btn-teal:hover{background:linear-gradient(135deg,var(--sky-600),var(--sky-700))}
.btn-cream{background:linear-gradient(135deg,var(--pink),var(--pink-deep));color:#fff;box-shadow:0 10px 26px rgba(236,72,153,.32)}
.btn-cream:hover{background:linear-gradient(135deg,var(--pink-deep),#DB2777)}
.btn-ghost{background:var(--ghost-bg);color:var(--ghost-ink);border:1px solid var(--ghost-border)}
.btn-ghost:hover{background:var(--ghost-bg-hover)}
.book-card .btn-ghost{background:rgba(255,255,255,.10);color:#fff;border:1px solid rgba(255,255,255,.35)}
.book-card .btn-ghost:hover{background:rgba(255,255,255,.18)}
.btn-sm{padding:9px 18px;font-size:13.5px}
.nav .btn{flex-shrink:0}
@media (max-width:760px){
  .nav-links{display:none}
  .nav{justify-content:space-between}
}

/* ---------- HERO ---------- */
.hero{
  position:relative;
  margin-top:-64px;
  padding:132px 0 0;
  background:var(--hero-bg);
  color:var(--ink);
  overflow:hidden;
  border-radius:0 0 36px 36px;
}
.hero-photo{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;object-position:center 72%;
  opacity:var(--hero-photo-opacity);pointer-events:none;
}
.hero-wash{position:absolute;inset:0;pointer-events:none;background:var(--hero-wash)}
.hero-aurora{position:absolute;inset:0;pointer-events:none;background:var(--aurora-bg)}
.hero-grain{position:absolute;inset:0;opacity:.5;pointer-events:none;background-image:var(--grain)}
.hero-inner{position:relative;text-align:center;padding-bottom:44px}
.hero-logo{
  width:148px;height:148px;margin:0 auto 26px;
  border-radius:32px;overflow:hidden;background:#fff;
  box-shadow:0 24px 60px rgba(2,132,199,.22), 0 0 0 1px rgba(255,255,255,.9);
}
.hero-logo img{width:100%;height:100%;object-fit:cover}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-size:12.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
  color:var(--eyebrow-ink);background:var(--eyebrow-bg);
  border:1px solid var(--eyebrow-border);
  padding:8px 16px;border-radius:999px;margin-bottom:22px;
}
.hero-eyebrow i{width:7px;height:7px;border-radius:50%;background:var(--pink-deep);display:inline-block}
.hero h1{
  font-size:clamp(44px,8.5vw,88px);
  font-weight:800;color:var(--ink);
  max-width:12.5ch;margin-inline:auto;
  text-wrap:balance;
}
.hero h1 em{font-style:normal;color:var(--pink-deep)}
.hero-sub{
  max-width:56ch;margin:22px auto 0;
  font-size:clamp(16px,2.4vw,19px);color:var(--ink-soft);font-weight:500;
  text-wrap:balance;
}
.hero-genres{margin-top:26px}
.hero-genres-label{
  font-size:11.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
  color:var(--accent-pink);margin-bottom:10px;
}
.hero-genre-chips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.hero-genre-chip{
  display:inline-flex;align-items:center;
  background:var(--pill-bg);color:var(--pill-ink);
  border:1px solid var(--card-border);
  font-family:"Outfit",sans-serif;font-weight:700;font-size:14px;
  padding:8px 16px;border-radius:999px;
}
.hero-genre-chip.pink{background:var(--pink-pale);color:var(--accent-pink)}
@media (prefers-color-scheme: dark){.hero-genre-chip.pink{background:rgba(244,114,182,.15)}}
.hero-ctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px}
.hero-meta{margin-top:18px;font-size:13.5px;color:var(--muted);font-weight:600}
.hero-strip{
  position:relative;
  display:grid;grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--strip-line);
  background:var(--strip-bg);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
}
.hero-strip div{padding:20px 18px 24px;text-align:left;border-left:1px solid var(--strip-line)}
.hero-strip div:first-child{border-left:none}
.hero-strip b{display:block;font-family:"Outfit",sans-serif;font-size:15px;color:var(--ink);margin-bottom:3px}
.hero-strip span{font-size:13px;color:var(--muted);line-height:1.45;display:block}
@media (max-width:760px){
  .hero-strip{grid-template-columns:1fr 1fr}
  .hero-strip div:nth-child(3){border-left:none}
  .hero-strip div{border-top:1px solid var(--strip-line)}
  .hero-strip div:nth-child(-n+2){border-top:none}
  .hero-logo{width:118px;height:118px;border-radius:26px}
}

/* ---------- SECTIONS ---------- */
section{padding:84px 0}
@media (max-width:560px){section{padding:60px 0}}
.kicker{
  font-size:12.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
  color:var(--accent-pink);display:flex;align-items:center;gap:10px;margin-bottom:14px;
}
.kicker::before{content:"";width:26px;height:2px;background:var(--accent-pink);border-radius:2px}
.kicker.center{justify-content:center}
.kicker.center::after{content:"";width:26px;height:2px;background:var(--accent-pink);border-radius:2px}
.sec-head{max-width:640px;margin-bottom:40px}
.sec-head.center{margin-inline:auto;text-align:center}
.sec-head h2{font-size:clamp(32px,5.4vw,50px);font-weight:800;text-wrap:balance}
.sec-head p{color:var(--muted);font-size:17px;margin:14px 0 0;text-wrap:balance}

/* ---------- SERVICES ---------- */
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media (max-width:920px){.svc-grid{grid-template-columns:1fr;max-width:560px;margin-inline:auto;width:100%}}
.svc{
  position:relative;overflow:hidden;
  background:var(--surface);
  border:1px solid var(--card-border);
  border-radius:var(--radius-lg);
  padding:30px 28px 28px;box-shadow:var(--shadow);
  display:flex;flex-direction:column;
}
.svc::before{
  content:"";position:absolute;inset:0 0 auto 0;height:120px;pointer-events:none;
  background:radial-gradient(70% 100% at 50% 0%, rgba(56,189,248,.20), transparent 70%);
}
.svc-num{
  font-family:"Outfit",sans-serif;font-weight:800;font-size:13px;letter-spacing:.14em;
  color:var(--accent-sky);margin-bottom:16px;position:relative;
}
.svc h3{font-size:27px;font-weight:800;position:relative}
.svc .svc-tag{font-weight:700;color:var(--accent-pink);font-size:14.5px;margin:6px 0 12px;position:relative}
.svc p{color:var(--muted);font-size:15.5px;margin:0 0 16px;position:relative}
.svc ul{list-style:none;margin:0 0 24px;padding:0;position:relative;display:grid;gap:9px}
.svc li{font-size:14.5px;font-weight:600;color:var(--ink-soft);display:flex;gap:10px;align-items:flex-start}
.svc li svg{flex-shrink:0;margin-top:3px}
.svc-foot{margin-top:auto;position:relative}
.price-pill{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--pill-bg);color:var(--pill-ink);
  font-family:"Outfit",sans-serif;font-weight:700;font-size:14px;
  padding:9px 16px;border-radius:999px;margin-bottom:16px;
}
.svc-link{
  display:inline-flex;align-items:center;gap:7px;
  font-family:"Outfit",sans-serif;font-weight:700;font-size:15px;color:var(--accent-sky);
  text-decoration:none;
}
.svc-link:hover{text-decoration:underline}
.services-note{text-align:center;color:var(--muted);font-size:14.5px;margin-top:26px}
.no-ai-banner{
  max-width:860px;margin:0 auto 28px;
  display:flex;align-items:center;justify-content:center;gap:14px;
  background:linear-gradient(120deg,var(--sky-700) 0%,var(--sky-500) 42%,var(--pink) 100%);
  color:#fff;
  border:1px solid rgba(255,255,255,.45);
  border-radius:var(--radius-md);
  padding:20px 26px;text-align:center;
  box-shadow:0 16px 38px rgba(236,72,153,.24);
  position:relative;overflow:hidden;
}
.no-ai-banner::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(60% 120% at 50% 0%, rgba(255,255,255,.28), transparent 70%);}
.no-ai-banner svg{flex-shrink:0;position:relative}
.no-ai-banner p{margin:0;position:relative;font-size:16.5px;line-height:1.55;font-weight:600;color:rgba(255,255,255,.94);text-wrap:balance}
.no-ai-banner p strong{font-family:"Outfit",sans-serif;font-weight:800;color:#fff;font-size:17.5px;white-space:nowrap}
@media (max-width:560px){
  .no-ai-banner{flex-direction:column;gap:10px;padding:20px 20px}
  .no-ai-banner p strong{white-space:normal}
}

/* ---------- DEMOS ---------- */
.demos{background:var(--demos-bg);color:var(--ink);border-radius:36px;margin:0 12px;position:relative;overflow:hidden;border:1px solid var(--card-border)}
@media (max-width:560px){.demos{margin:0 8px;border-radius:28px}}
.demos::before{content:"";position:absolute;inset:0;pointer-events:none;background:var(--demos-glow)}
.demos .wrap{position:relative}
.demos .kicker{color:var(--accent-pink)}
.demos .kicker::before,.demos .kicker::after{background:var(--accent-pink)}
.demos .sec-head h2{color:var(--ink)}
.demos .sec-head p{color:var(--muted)}
.genre-tabs{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:26px}
.genre-tab{
  font-family:"Outfit",sans-serif;font-weight:700;font-size:14.5px;
  padding:10px 20px;border-radius:999px;cursor:pointer;
  background:var(--tab-bg);color:var(--tab-ink);
  border:1px solid var(--tab-border);
  transition:background .2s,color .2s,border-color .2s;
}
.genre-tab:hover{background:var(--tab-bg-hover);color:var(--ink)}
.genre-tab.active{background:linear-gradient(135deg,var(--sky-500),var(--sky-600));color:#fff;border-color:transparent;box-shadow:0 8px 20px rgba(14,165,233,.30)}
.player-card{
  background:var(--player-bg);
  -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);
  border:1px solid var(--card-border);
  border-radius:var(--radius-lg);
  padding:14px;
  max-width:760px;margin-inline:auto;
  box-shadow:var(--shadow);
}
.track{
  display:flex;align-items:center;gap:16px;
  padding:16px 14px;border-radius:var(--radius-md);
  transition:background .2s;
}
.track + .track{border-top:1px solid var(--track-line)}
.track:hover{background:var(--track-hover)}
.track.playing{background:var(--track-playing)}
.play-btn{
  width:52px;height:52px;flex-shrink:0;border-radius:50%;
  border:none;cursor:pointer;
  background:linear-gradient(135deg,var(--pink),var(--pink-deep));color:#fff;
  display:grid;place-items:center;
  box-shadow:0 8px 22px rgba(236,72,153,.35);
  transition:transform .15s,background .2s;
}
.play-btn:hover{transform:scale(1.06)}
.play-btn:disabled{
  background:var(--play-off-bg);color:var(--play-off-ink);
  box-shadow:none;cursor:default;transform:none;
}
.track-main{flex:1;min-width:0}
.track-title{font-family:"Outfit",sans-serif;font-weight:700;font-size:16.5px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.track-artist{font-size:13.5px;color:var(--muted);font-weight:600}
.track-prog{
  height:5px;border-radius:999px;background:var(--prog-bg);
  margin-top:10px;cursor:pointer;position:relative;
}
.track-prog-fill{height:100%;width:0%;border-radius:999px;background:linear-gradient(90deg,var(--sky),var(--pink))}
.track-time{font-size:13px;font-weight:700;color:var(--ink-soft);font-variant-numeric:tabular-nums;flex-shrink:0;min-width:38px;text-align:right}
.soon-chip{
  flex-shrink:0;font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  color:var(--accent-pink);background:var(--pink-pale);border:1px solid rgba(236,72,153,.35);
  padding:5px 11px;border-radius:999px;
}
@media (prefers-color-scheme: dark){.soon-chip{background:rgba(244,114,182,.13)}}
.demos-empty-note{text-align:center;color:var(--muted);font-size:15px;max-width:52ch;margin:22px auto 0}
.human-badge{
  display:inline-flex;align-items:center;gap:8px;
  margin-top:18px;
  font-family:"Outfit",sans-serif;font-weight:800;font-size:13.5px;letter-spacing:.04em;

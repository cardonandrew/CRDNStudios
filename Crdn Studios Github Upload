/* ---------- Demo player ---------- */
var audio = document.getElementById("audioEl");
var tabsEl = document.getElementById("genreTabs");
var listEl = document.getElementById("trackList");
var noteEl = document.getElementById("demosNote");
var activeGenre = "all";
var demosExpanded = false;
var current = null; /* { track, row, btn, fill, timeEl, prog, index } */
var queue = []; /* full filtered track list for active genre, in lineup order */
var rowRefs = []; /* [{track,row,btn,fill,timeEl,prog}] for all rows in queue */
var currentIndex = -1;
var miniEl = document.getElementById("miniPlayer");
var miniTitle = document.getElementById("miniTitle");
var miniArtist = document.getElementById("miniArtist");
var miniToggle = document.getElementById("miniToggle");
var miniPrev = document.getElementById("miniPrev");
var miniNext = document.getElementById("miniNext");
var miniClose = document.getElementById("miniClose");
var miniProg = document.getElementById("miniProg");
var miniFill = document.getElementById("miniFill");
var miniTime = document.getElementById("miniTime");

/* Autoplay-chain state. Mobile browsers (esp. iOS Safari / in-app webviews)
   reject a play() call that is not made inside a tap once the previous track
   has fully ended and src has changed — the promise rejects, the next song
   is cued in the UI, but nothing sounds until the user presses play.
   wantPlay records the user's intent to keep listening; playGen invalidates
   stale retry callbacks whenever the track changes or playback is stopped. */
var playGen = 0;
var wantPlay = false;
var advancing = false;
var pendingRetry = null;
var preloadedSrc = "";
var preloader = document.createElement("audio");
preloader.preload = "auto";

function clearPendingRetry(){
  if (pendingRetry) { audio.removeEventListener("canplay", pendingRetry); pendingRetry = null; }
}
function attemptPlay(){
  var gen = playGen;
  var p = audio.play();
  if (p && typeof p.catch === "function") {
    p.catch(function(){
      if (gen !== playGen || !wantPlay) return;
      /* Blocked/aborted chained play(): retry the moment the new track has
         buffered enough to start, instead of leaving it silently paused. */
      clearPendingRetry();
      pendingRetry = function(){
        clearPendingRetry();
        if (gen !== playGen || !wantPlay) return;
        var p2 = audio.play();
        if (p2 && typeof p2.catch === "function") p2.catch(function(){});
      };
      audio.addEventListener("canplay", pendingRetry);
      if (audio.readyState >= 3) pendingRetry();
    });
  }
}
function preloadNext(idx){
  /* Warm the browser cache with the next track while the current one plays,
     so the handover starts instantly instead of waiting on the network. */
  var n = queue[idx + 1];
  if (!n || preloadedSrc === n.src) return;
  preloadedSrc = n.src;
  preloader.src = n.src;
  try { preloader.load(); } catch(e) {}
}

var ICON_PLAY  = '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5z"/></svg>';
var ICON_PAUSE = '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2"/><rect x="14" y="5" width="4" height="14" rx="1.2"/></svg>';

function fmt(sec){
  if (!isFinite(sec) || sec == null) return "0:00";
  var m = Math.floor(sec / 60), s = Math.floor(sec % 60);
  return m + ":" + (s < 10 ? "0" : "") + s;
}
function genreLabel(id){
  for (var i = 0; i < DEMO_GENRES.length; i++) if (DEMO_GENRES[i].id === id) return DEMO_GENRES[i].label;
  return id;
}

function renderTabs(){
  tabsEl.innerHTML = "";
  var all = [{ id: "all", label: "All Genres" }].concat(DEMO_GENRES);
  all.forEach(function(g){
    var b = document.createElement("button");
    b.type = "button";
    b.className = "genre-tab" + (g.id === activeGenre ? " active" : "");
    b.textContent = g.label;
    b.setAttribute("role", "tab");
    b.setAttribute("aria-selected", g.id === activeGenre ? "true" : "false");
    b.addEventListener("click", function(){
      activeGenre = g.id;
      demosExpanded = false;
      renderTabs(); renderTracks();
    });
    tabsEl.appendChild(b);
  });
}

function showMini(){
  if (!miniEl) return;
  miniEl.classList.add("visible");
  miniEl.setAttribute("aria-hidden", "false");
  document.body.classList.add("has-mini");
}
function hideMini(){
  if (!miniEl) return;
  miniEl.classList.remove("visible");
  miniEl.setAttribute("aria-hidden", "true");
  document.body.classList.remove("has-mini");
}
function syncUI(){
  var playing = !audio.paused && !audio.ended;
  rowRefs.forEach(function(ref){
    var isCur = current && current.track === ref.track;
    if (isCur) {
      ref.row.classList.add("playing");
      ref.btn.innerHTML = playing ? ICON_PAUSE : ICON_PLAY;
      ref.btn.setAttribute("aria-label", (playing ? "Pause " : "Play ") + ref.track.title);
    } else {
      ref.row.classList.remove("playing");
      ref.btn.innerHTML = ICON_PLAY;
      ref.btn.setAttribute("aria-label", "Play " + ref.track.title);
      ref.fill.style.width = "0%";
      if (ref.timeEl) ref.timeEl.textContent = ref.track.duration || "0:00";
    }
  });
  if (current) {
    miniTitle.textContent = current.track.title;
    miniArtist.textContent = current.track.genre ? current.track.artist + " · " + genreLabel(current.track.genre) : current.track.artist;
    miniToggle.innerHTML = playing ? ICON_PAUSE : ICON_PLAY;
    miniToggle.setAttribute("aria-label", (playing ? "Pause " : "Play ") + current.track.title);
  }
}
function updateProgressUI(){
  if (!current) return;
  var pct = (isFinite(audio.duration) && audio.duration > 0) ? (audio.currentTime / audio.duration * 100) : 0;
  if (current.fill) current.fill.style.width = pct + "%";
  miniFill.style.width = pct + "%";
  miniProg.setAttribute("aria-valuenow", String(Math.round(pct)));
  var cur = fmt(audio.currentTime || 0);
  var dur = current.track.duration || (isFinite(audio.duration) ? fmt(audio.duration) : "0:00");
  if (current.timeEl) current.timeEl.textContent = (audio.currentTime > 0 ? cur + " / " + dur : dur);
  miniTime.textContent = cur + " / " + dur;
}
function stopCurrent(){
  wantPlay = false; playGen++; clearPendingRetry(); advancing = false;
  if (!current) { hideMini(); return; }
  audio.pause();
  current = null;
  currentIndex = -1;
  syncUIAfterClear();
  hideMini();
}
function syncUIAfterClear(){
  rowRefs.forEach(function(ref){
    ref.row.classList.remove("playing");
    ref.btn.innerHTML = ICON_PLAY;
    ref.btn.setAttribute("aria-label", "Play " + ref.track.title);
    ref.fill.style.width = "0%";
    if (ref.timeEl) ref.timeEl.textContent = ref.track.duration || "0:00";
  });
  miniFill.style.width = "0%";
  miniTime.textContent = "0:00 / 0:00";
}
function closePlayer(){
  wantPlay = false; playGen++; clearPendingRetry(); advancing = false;
  try { audio.pause(); } catch(e) {}
  try { audio.removeAttribute("src"); audio.load(); } catch(e) {}
  current = null;
  currentIndex = -1;
  syncUIAfterClear();
  hideMini();
}
function playAtIndex(idx, shouldPlay){
  if (idx < 0 || idx >= queue.length) return;
  var track = queue[idx];
  var ref = null;
  for (var i = 0; i < rowRefs.length; i++) if (rowRefs[i].track === track) { ref = rowRefs[i]; break; }
  playGen++;
  clearPendingRetry();
  advancing = false;
  wantPlay = (shouldPlay !== false);
  currentIndex = idx;
  current = { track: track, row: ref ? ref.row : null, btn: ref ? ref.btn : null, fill: ref ? ref.fill : null, timeEl: ref ? ref.timeEl : null, prog: ref ? ref.prog : null, index: idx };
  audio.preload = "auto";
  audio.src = track.src;
  try { audio.load(); } catch(e) {}
  showMini();
  syncUI();
  miniFill.style.width = "0%";
  miniTime.textContent = "0:00 / " + (track.duration || "0:00");
  preloadNext(idx);
  if (wantPlay) attemptPlay();
}
function playNext(autoplay){
  if (!queue.length) return;
  if (currentIndex < 0) { playAtIndex(0, true); return; }
  if (currentIndex >= queue.length - 1) {
    if (autoplay) return; /* queue ended — stop */
    playAtIndex(0, true); /* manual next wraps to first */
    return;
  }
  playAtIndex(currentIndex + 1, true);
}
function playPrev(){
  if (!queue.length) return;
  if (currentIndex < 0) { playAtIndex(queue.length - 1, true); return; }
  /* If well into a track, restart it first (common player behaviour) */
  if (audio.currentTime > 3) { audio.currentTime = 0; return; }
  if (currentIndex <= 0) { playAtIndex(queue.length - 1, true); return; }
  playAtIndex(currentIndex - 1, true);
}

function makePlayBtn(track, onClick){
  var b = document.createElement("button");
  b.type = "button";
  b.className = "play-btn";
  b.innerHTML = ICON_PLAY;
  b.setAttribute("aria-label", track.artist ? "Play " + track.title + " by " + track.artist : "Play " + track.title);
  b.addEventListener("click", onClick);
  return b;
}

function renderTracks(){
  /* Genre / initial render resets playback; See more/less does NOT call this (it toggles rows in place) */
  wantPlay = false; playGen++; clearPendingRetry(); advancing = false;
  try { audio.pause(); } catch(e) {}
  try { audio.removeAttribute("src"); } catch(e) {}
  current = null;
  currentIndex = -1;
  hideMini();
  listEl.innerHTML = "";
  rowRefs = [];

  var tracks = DEMO_TRACKS.filter(function(t){ return activeGenre === "all" || t.genre === activeGenre; });
  queue = tracks.slice();

  if (tracks.length === 0) {
    queue = [];
    var genres = activeGenre === "all" ? DEMO_GENRES : DEMO_GENRES.filter(function(g){ return g.id === activeGenre; });
    genres.forEach(function(g){
      var row = document.createElement("div");
      row.className = "track";
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "play-btn";
      btn.disabled = true;
      btn.innerHTML = ICON_PLAY;
      btn.setAttribute("aria-label", g.label + " demo coming soon");
      var main = document.createElement("div");
      main.className = "track-main";
      main.innerHTML = '<div class="track-title">' + g.label + '</div>' +
                       '<div class="track-artist">Demos coming soon — tracks in preparation</div>' +
                       '<div class="track-prog"><div class="track-prog-fill"></div></div>';
      var chip = document.createElement("span");
      chip.className = "soon-chip";
      chip.textContent = "Coming soon";
      row.appendChild(btn); row.appendChild(main); row.appendChild(chip);
      listEl.appendChild(row);
    });
    noteEl.style.display = "";
    return;
  }

  noteEl.style.display = "none";
  tracks.forEach(function(track, idx){
    var hidden = !demosExpanded && idx >= 3;
    var row = document.createElement("div");
    row.className = "track";
    var main = document.createElement("div");
    main.className = "track-main";
    var title = document.createElement("div");
    title.className = "track-title"; title.textContent = track.title;
    var artist = document.createElement("div");
    artist.className = "track-artist"; artist.textContent = track.genre ? track.artist + " · " + genreLabel(track.genre) : track.artist;
    var prog = document.createElement("div");
    prog.className = "track-prog";
    var fill = document.createElement("div");
    fill.className = "track-prog-fill";
    prog.appendChild(fill);
    main.appendChild(title); main.appendChild(artist); main.appendChild(prog);
    var time = document.createElement("span");
    time.className = "track-time";
    time.textContent = track.duration || "0:00";

    var btn = makePlayBtn(track, function(){
      if (current && current.track === track) {
        if (audio.paused) { wantPlay = true; var pp = audio.play(); if (pp && pp.catch) pp.catch(function(){}); showMini(); }
        else { wantPlay = false; audio.pause(); }
        return;
      }
      /* Jump queue to this track — works for hidden rows too, queue is full filtered list */
      var qi = queue.indexOf(track);
      playAtIndex(qi >= 0 ? qi : idx, true);
    });

    prog.addEventListener("click", function(e){
      if (!current || current.track !== track || !isFinite(audio.duration) || audio.duration === 0) return;
      var r = prog.getBoundingClientRect();
      audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
    });

    if (hidden) row.style.display = "none";
    row.dataset.queueIndex = String(idx);
    row.appendChild(btn); row.appendChild(main); row.appendChild(time);
    listEl.appendChild(row);
    rowRefs.push({ track: track, row: row, btn: btn, fill: fill, timeEl: time, prog: prog });
  });

  if (tracks.length > 3) {
    var bar = document.createElement("div");
    bar.className = "see-toggle-bar";
    var toggleBtn = document.createElement("button");
    toggleBtn.type = "button";
    toggleBtn.className = demosExpanded ? "btn btn-ghost" : "btn btn-teal";
    toggleBtn.textContent = demosExpanded ? "See less" : "See more";
    toggleBtn.addEventListener("click", function(){
      demosExpanded = !demosExpanded;
      /* Toggle in place so playback / queue are never interrupted */
      rowRefs.forEach(function(ref, i){
        ref.row.style.display = (!demosExpanded && i >= 3) ? "none" : "";
      });
      toggleBtn.textContent = demosExpanded ? "See less" : "See more";
      toggleBtn.className = demosExpanded ? "btn btn-ghost" : "btn btn-teal";
    });
    bar.appendChild(toggleBtn);
    listEl.appendChild(bar);
  }
}

audio.addEventListener("play", function(){ syncUI(); });
audio.addEventListener("pause", function(){ syncUI(); });
audio.addEventListener("timeupdate", function(){
  if (!current) return;
  updateProgressUI();
  /* AUTOPLAY (mobile-safe handover): switch to the next track just BEFORE
     this one ends, while the element is still in a playing state. Waiting
     for "ended" and calling play() after changing src gets blocked by
     mobile browsers — no tap, no play — which left the next song cued but
     silent until the play button was pressed. The cut lands inside the
     baked-in fade-out tail, so it is inaudible. The "ended" handler below
     remains as a fallback (e.g. throttled timers in a background tab). */
  if (wantPlay && !advancing && currentIndex >= 0 && currentIndex < queue.length - 1 &&
      isFinite(audio.duration) && audio.duration > 0) {
    var remaining = audio.duration - audio.currentTime;
    if (remaining > 0 && remaining <= 0.45) {
      advancing = true;
      playAtIndex(currentIndex + 1, true);
    }
  }
});
audio.addEventListener("loadedmetadata", function(){ updateProgressUI(); });
audio.addEventListener("ended", function(){
  if (!current) return;
  /* AUTOPLAY: advance to next in queue until paused / closed / queue ends */
  if (currentIndex >= 0 && currentIndex < queue.length - 1) {
    playAtIndex(currentIndex + 1, true);
    return;
  }
  /* Last track — stop, reset progress, keep mini visible paused so it can be replayed */
  wantPlay = false;
  if (current.fill) current.fill.style.width = "0%";
  if (current.timeEl) current.timeEl.textContent = current.track.duration || "0:00";
  miniFill.style.width = "0%";
  miniTime.textContent = "0:00 / " + (current.track.duration || "0:00");
  syncUI();
  if (current && current.row) current.row.classList.remove("playing");
});

/* ---------- Mini-player controls ---------- */
miniToggle.addEventListener("click", function(){
  if (!current) {
    if (queue.length) playAtIndex(0, true);
    return;
  }
  if (audio.paused) { wantPlay = true; var p = audio.play(); if (p && p.catch) p.catch(function(){}); showMini(); }
  else { wantPlay = false; audio.pause(); }
});
miniNext.addEventListener("click", function(){ playNext(false); });
miniPrev.addEventListener("click", function(){ playPrev(); });
miniClose.addEventListener("click", function(){ closePlayer(); });
miniProg.addEventListener("click", function(e){
  if (!current || !isFinite(audio.duration) || audio.duration === 0) return;
  var r = miniProg.getBoundingClientRect();
  audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
});

renderTabs();
renderTracks();
</script>
